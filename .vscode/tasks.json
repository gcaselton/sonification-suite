{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend",
      "type": "shell",
      "command": "../../.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload"
      ],
      "windows": {
        "command": "..\\..\\.venv\\Scripts\\python.exe"
      },
      "options": {
        "cwd": "src/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Frontend",
      "type": "shell",
      "command": "npm",
      "args": [
        "run",
        "dev"
      ],
      "options": {
        "cwd": "src/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Full Stack App",
      "dependsOn": [
        "Run Backend",
        "Run Frontend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}